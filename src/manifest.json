{
  "manifest_version": 3,
  "name": "Reqlyst — Web Request Inspector",
  "short_name": "Reqlyst",
  "version": "2.1.1",
  "description": "Inspect and filter HTTP(S) requests from your current browser tab.",
  "action": {
    "default_title": "Reqlyst — Inspect requests",
    "default_popup": "index.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "permissions": [
    "webRequest",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
