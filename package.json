{
  "name": "web-requests-inspector",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "ng serve",
    "build": "ng build --configuration production",
    "build:extension": "npm run build",
    "chrome-extension:build": "npm run build",
    "test": "npm run test:unit",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run test:unit && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@angular/common": "~22.2.5",
    "@angular/compiler": "~22.2.5",
    "@angular/core": "~22.2.5",
    "@angular/platform-browser": "~22.2.5",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "~22.2.5",
    "@angular/cli": "~22.2.5",
    "@angular/compiler-cli": "~22.2.5",
    "@playwright/test": "^1.64.0",
    "@types/chrome": "^0.3.7",
    "typescript": "~6.0.0"
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
